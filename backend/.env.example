PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/hiking-explorer

# Redis (Production REDIS_URL or fallback host/port/password)
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_ACCESS_SECRET=super_secret_access_key_change_in_production_hiking_2026
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_production_hiking_2026
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# AI Platform
AI_PLATFORM_URL=https://api.ai-platform.example.com
AI_PLATFORM_API_KEY=ai_hiking_api_key_mock_or_live
AI_PLATFORM_HIKING_API_KEY=ai_hiking_api_key_mock_or_live
AI_PLATFORM_TIMEOUT_MS=15000

# Notification Service
NOTIFICATION_SERVICE_URL=https://api.notifications.example.com
NOTIFICATION_SERVICE_API_KEY=notification_hiking_key_mock_or_live
NOTIFICATION_HIKING_API_KEY=notification_hiking_key_mock_or_live
NOTIFICATION_SERVICE_TIMEOUT_MS=10000

# External Providers
TRAIL_PROVIDER_BASE_URL=https://api.overpass-api.de/api
TRAIL_PROVIDER_API_KEY=
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
WEATHER_API_KEY=

PUBLIC_ACCESS_ENABLED=true
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
